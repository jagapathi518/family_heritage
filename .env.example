# ==============================================================================
# DIGITAL FAMILY HERITAGE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and populate with your Supabase credentials:
# cp .env.example .env.local

# Supabase API Settings
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Supabase Service Role Key (Used ONLY in secure backend admin scripts/migrations, NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Base URL (for auth redirects and invitation links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
